{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Rolando Game",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",

            // UNIVERSAL debugger path (uses PATH)
            "miDebuggerPath": "gdb",

            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],

            // Universal preLaunchTask
            "preLaunchTask": "Build All C++"
        }
    ]
}
