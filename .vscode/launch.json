{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++ Debug (gdb.exe)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/main.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // Link to the build task created in tasks.json
            "preLaunchTask": "C/C++: g++.exe build all cpp with C++11"
        }
    ]
}