{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch Game",
            "type": "cppdbg",
            "request": "launch",
            // Path to the executable created by tasks.json
            "program": "${workspaceFolder}/main.exe", 
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true, // Opens a separate console window for program I/O
            "MIMode": "gdb",
            // Make sure this path is correct for your MinGW installation
            "miDebuggerPath": "C:\\mingw64\\bin\\gdb.exe", 
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            // IMPORTANT: Runs your custom multi-file build task first
            "preLaunchTask": "C/C++: g++.exe build all cpp with C++11" 
        }
    ]
}