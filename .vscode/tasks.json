{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Game",
            "type": "process",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "main.cpp",
                "Game.cpp",
                "Character.cpp",
                "-lwinmm",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}" 
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
