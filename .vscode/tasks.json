{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All C++",
            "type": "shell",
            "command": "g++",
            "args": [
                "-g",
                "-std=c++11",
                "*.cpp",
                "-o",
                "main.exe",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
