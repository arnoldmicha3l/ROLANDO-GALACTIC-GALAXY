{
    "version": "2.0.0",
    "tasks": [
        {
            // This is the multi-file build task that worked successfully
            "label": "C/C++: g++.exe build all cpp with C++11",
            "type": "shell",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++11",
                // Explicitly list all your source files for the linker
                "${fileDirname}\\main.cpp",
                "${fileDirname}\\Game.cpp",
                "${fileDirname}\\Character.cpp",
                "-o",
                "${fileDirname}\\main.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                // Set this as the default build task
                "isDefault": true 
            },
            "detail": "Compiler: C:\\mingw64\\bin\\g++.exe"
        },
        {
            // This is the original task, now set to NOT be the default
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}