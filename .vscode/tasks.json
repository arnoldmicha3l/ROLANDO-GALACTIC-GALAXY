{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C/C++: g++.exe build all cpp with C++11",
            "type": "shell",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-std=c++11",
                // CHANGED: Use ${workspaceFolder} for consistency with debugger
