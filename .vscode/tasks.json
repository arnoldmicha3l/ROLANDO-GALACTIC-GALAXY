{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Galactica Game",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-g",
        "-std=c++11",
        "${workspaceFolder}/main.cpp",
        "${workspaceFolder}/Game.cpp",
        "${workspaceFolder}/Character.cpp",
        "-o",
        "${workspaceFolder}/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}