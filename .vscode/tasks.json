            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: C:\\mingw64\\bin\\g++.exe"
        },
        // ... (other tasks)
    ]
